# WordPress MCP Project .gitignore

# Credentials and sensitive files
apppass
*.pem
*.key
.env
.env.local

# WordPress specific
wp-config.php
.htaccess

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
*.temp
.cache/
tmp/

# Backup files
*.bak
*.backup
*~

# OS specific
Thumbs.db
.DS_Store

# Node modules (if any)
node_modules/

# Build artifacts
dist/
build/

# Zip files (keep only in plugins/)
/*.zip
!plugins/*.zip

# Old/deprecated files
*.old
*.deprecated
_old/
_backup/
