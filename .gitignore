# WordPress MCP Project .gitignore

# Credentials and sensitive files
apppass
*.pem
*.key
.env
.env.local
.env.example

# WordPress specific
wp-config.php
.htaccess

# IDE and editor files
.vscode/
.idea/
.qoder/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
output.log
server.log

# Temporary files
*.tmp
*.temp
.cache/
tmp/

# Backup files
*.bak
*.backup

# OS specific
Thumbs.db
.DS_Store

# Dependencies
node_modules/

# Build artifacts
dist/
build/

# Zip files (keep only in plugins/)
/*.zip
!plugins/*.zip

# Old/deprecated files
*.old
*.deprecated
_old/
_backup/

# Debug/diagnostic files
dump-content.ts
inspect-page.ts
test-discovery.ts
test_camoufox.ts
cleanup.ts
deep-rescue.ts
diagnose-structure.ts
fix-settings.ts
manual-fix.ts
rescue.ts
site-audit.ts

# Debug output files (but keep templates/)
!templates/*.html
home_content.html
login-page.html
login-failure.png
raw_content_12.txt

# Project management
openspec/

# Qoder files
QODER.md
AGENTS.md
